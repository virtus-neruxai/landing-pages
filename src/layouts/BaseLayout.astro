---
import '@fontsource-variable/inter';
import '@fontsource/spectral/latin-400.css';
import '@fontsource/spectral/latin-500.css';
import '@fontsource/spectral/latin-500-italic.css';
import '@fontsource/lora/latin-600.css';
import '@fontsource/nunito-sans/latin-600.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/bitter/latin-600.css';
import '../styles/global.css';
import type { ZoneProfile } from '../components/zones/zoneContent';

interface Props {
  title?: string;
  description?: string;
  profile?: ZoneProfile;
}

const {
  title = 'Virtus por NeruxAI — convierte tu propósito en acción',
  description = 'Convierte tus objetivos en tareas y rutinas conectadas con lo que de verdad te importa. Virtus se adapta a tu progreso, energía y contexto real.',
  profile,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f8f5f2" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body data-profile={profile}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <script>
      type LandingEvent = {
        name: string;
        properties?: Record<string, string>;
      };

      type CampaignData = Partial<Record<'source' | 'medium' | 'campaign' | 'content' | 'influencer_id', string>>;

      const campaignStorageKey = 'virtus:campaign';
      const campaignParams = [
        ['utm_source', 'source'],
        ['utm_medium', 'medium'],
        ['utm_campaign', 'campaign'],
        ['utm_content', 'content'],
        ['influencer_id', 'influencer_id'],
      ] as const;

      const readCampaign = (): CampaignData => {
        let stored: CampaignData = {};

        try {
          const parsed = JSON.parse(window.sessionStorage.getItem(campaignStorageKey) ?? '{}') as unknown;
          if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
            stored = parsed as CampaignData;
          }
        } catch {
          stored = {};
        }

        const query = new URLSearchParams(window.location.search);
        campaignParams.forEach(([queryKey, propertyKey]) => {
          const value = query.get(queryKey)?.trim();
          if (value) stored[propertyKey] = value;
        });

        try {
          window.sessionStorage.setItem(campaignStorageKey, JSON.stringify(stored));
        } catch {
          // La landing sigue funcionando si el navegador bloquea sessionStorage.
        }

        return stored;
      };

      const campaign = readCampaign();
      const pageProfile = document.body.dataset.profile;
      const sharedProperties = {
        ...campaign,
        ...(pageProfile ? { profile: pageProfile } : {}),
      };

      const decorateAppLink = (link: HTMLAnchorElement) => {
        try {
          const destination = new URL(link.href, window.location.href);
          campaignParams.forEach(([queryKey, propertyKey]) => {
            const value = campaign[propertyKey];
            if (value && !destination.searchParams.has(queryKey)) destination.searchParams.set(queryKey, value);
          });
          if (pageProfile && !destination.searchParams.has('profile')) destination.searchParams.set('profile', pageProfile);

          if (pageProfile) {
            let selectedSituation: string | null = null;
            try {
              selectedSituation = window.sessionStorage.getItem(`virtus:zone-situation:${pageProfile}`);
            } catch {
              // La campaña de la URL se conserva aunque el navegador bloquee sessionStorage.
            }
            if (selectedSituation) destination.searchParams.set('selected_situation', selectedSituation);
          }

          link.href = destination.toString();
        } catch {
          // Un enlace inválido no debe bloquear el resto de la página.
        }
      };

      document.querySelectorAll<HTMLAnchorElement>('a[data-app-link]').forEach(decorateAppLink);

      window.addEventListener(
        'virtus:analytics',
        (event) => {
          const detail = (event as CustomEvent<LandingEvent>).detail;
          if (!detail) return;
          detail.properties = { ...sharedProperties, ...(detail.properties ?? {}) };
        },
        { capture: true },
      );

      const emitLandingEvent = ({ name, properties = {} }: LandingEvent) => {
        window.dispatchEvent(
          new CustomEvent('virtus:analytics', {
            detail: { name, properties: { ...sharedProperties, ...properties }, timestamp: new Date().toISOString() },
          }),
        );
      };

      if (pageProfile) {
        emitLandingEvent({
          name: 'profile_landing_view',
          properties: { profile: pageProfile },
        });
      }

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const appLink = target.closest<HTMLAnchorElement>('a[data-app-link]');
        if (appLink) decorateAppLink(appLink);

        const trackedElement = target.closest<HTMLElement>('[data-track]');

        if (trackedElement) {
          emitLandingEvent({
            name: trackedElement.dataset.track ?? 'landing_click',
            properties: {
              location: trackedElement.dataset.trackLocation ?? 'unknown',
              label: trackedElement.textContent?.trim() ?? '',
            },
          });
        }

        const demoLink = target.closest<HTMLElement>('[data-focus-demo]');
        if (demoLink) {
          const focusMissionInput = () => {
            document.querySelector<HTMLTextAreaElement>('#mission-input')?.focus({ preventScroll: true });
          };
          const demoIsland = document.querySelector('#mission-input')?.closest('astro-island');

          if (demoIsland?.hasAttribute('ssr')) {
            window.addEventListener('virtus:demo-ready', focusMissionInput, { once: true });
          } else {
            window.setTimeout(focusMissionInput, 100);
          }
        }
      });

      const observedSections = new Set<string>();
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const section = entry.target as HTMLElement;
            const sectionName = section.dataset.trackSection;
            if (!sectionName || observedSections.has(sectionName)) return;

            observedSections.add(sectionName);
            emitLandingEvent({
              name: 'landing_section_view',
              properties: { section: sectionName },
            });
            sectionObserver.unobserve(section);
          });
        },
        { threshold: 0.35 },
      );

      document.querySelectorAll<HTMLElement>('[data-track-section]').forEach((section) => {
        sectionObserver.observe(section);
      });
    </script>
  </body>
</html>
