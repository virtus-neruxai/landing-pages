---
import HeroDemo from './HeroDemo';
---

<section class="hero" aria-labelledby="hero-title" data-track-section="hero">
  <div class="hero-orbit hero-orbit--outer" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit--inner" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="eyebrow-mark" aria-hidden="true"></span>
        NeruxAI — salud física, mental y espiritual
      </p>
      <h1 id="hero-title">Deja de posponer lo que de verdad te importa</h1>
      <p class="hero-lede">
        Escribe tu objetivo. Virtus lo convierte en tareas y rutinas conectadas con tu propósito — y se adapta según cómo vas de verdad.
      </p>
      <div class="hero-actions">
        <a
          class="button button--primary"
          href="#prueba-tu-mision"
          data-focus-demo
          data-track="mission_cta_clicked"
          data-track-location="hero"
        >
          Escribe tu misión
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <span class="hero-note">
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path d="m5.5 10.5 2.8 2.8 6.2-6.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Sin tarjeta. Resultado en 10 segundos.
        </span>
      </div>
    </div>

    <div class="hero-demo-wrap">
      <p class="demo-coordinate" aria-hidden="true">N 40.4168° · W 3.7038°</p>
      <HeroDemo client:visible />
    </div>
  </div>

  <div class="hero-footer container" aria-hidden="true">
    <span>Tu norte</span>
    <span class="hero-footer-line"></span>
    <span>Un plan posible</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: clip;
    padding: 8.5rem 0 3rem;
    background:
      radial-gradient(circle at 86% 32%, rgb(59 76 140 / 28%), transparent 30rem),
      linear-gradient(145deg, #17181c 0%, #1b1c22 55%, #17181c 100%);
    color: var(--bone);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(242 238 230 / 12%) 0.7px, transparent 0.7px);
    background-size: 22px 22px;
    content: '';
    mask-image: linear-gradient(to right, transparent, #000 35%, #000 100%);
    opacity: 0.35;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.45rem;
    color: rgb(242 238 230 / 68%);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 500;
    letter-spacing: 0.075em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .eyebrow-mark {
    position: relative;
    width: 0.7rem;
    height: 0.7rem;
    flex: 0 0 auto;
    border: 1px solid var(--ochre);
    border-radius: 50%;
  }

  .eyebrow-mark::after {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--ochre);
    content: '';
  }

  h1 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-variation-settings: 'SOFT' 64, 'WONK' 0;
    font-weight: 520;
    letter-spacing: -0.055em;
    line-height: 0.97;
  }

  .hero-lede {
    max-width: 38rem;
    margin-bottom: 2rem;
    color: rgb(242 238 230 / 76%);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: rgb(242 238 230 / 58%);
    font-size: 0.78rem;
  }

  .hero-note svg {
    width: 1rem;
    height: 1rem;
    color: var(--ochre);
  }

  .hero-demo-wrap {
    position: relative;
    min-width: 0;
  }

  .demo-coordinate {
    margin: 0 0 0.7rem;
    color: rgb(242 238 230 / 37%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-align: right;
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgb(242 238 230 / 8%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-orbit--outer {
    top: 2rem;
    right: -18rem;
    width: 48rem;
    height: 48rem;
  }

  .hero-orbit--inner {
    top: 11rem;
    right: -9rem;
    width: 30rem;
    height: 30rem;
  }

  .hero-footer {
    position: relative;
    z-index: 2;
    display: none;
    align-items: center;
    gap: 1rem;
    margin-top: 4rem;
    color: rgb(242 238 230 / 32%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero-footer-line {
    width: 7rem;
    height: 1px;
    background: linear-gradient(to right, var(--ochre), transparent);
  }

  @media (min-width: 42rem) {
    .hero-actions {
      align-items: center;
      flex-direction: row;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      display: flex;
      min-height: 52rem;
      align-items: center;
      padding: 8rem 0 3rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(30rem, 1.08fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .hero-footer {
      position: absolute;
      right: 0;
      bottom: 2.15rem;
      left: 0;
      display: flex;
    }
  }
</style>
