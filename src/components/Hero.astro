---
import CenterFormula from './CenterFormula.astro';

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const mentorUrl = `${appUrl}/mentor`;
---

<section class="hero" aria-labelledby="hero-title" data-track-section="hero">
  <div class="hero-ambient" aria-hidden="true">
    <span class="hero-blob hero-blob--flow"></span>
    <span class="hero-blob hero-blob--root"></span>
    <svg class="hero-current" viewBox="0 0 1200 720" preserveAspectRatio="none">
      <path d="M-80 510C140 398 238 566 432 453S742 227 1280 350"></path>
      <path d="M-40 576C184 466 300 624 518 501S820 317 1250 416"></path>
    </svg>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="eyebrow-mark" aria-hidden="true">
          <svg viewBox="0 0 28 18" fill="none">
            <path d="M2 11c4.5-5.2 9.2-5.2 13.6-1.2 3.4 3.1 6.7 3.1 10.4-1.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            <path d="M15.5 9.5c1.2-4 4.3-6.2 8.2-6.5-.4 3.8-2.7 6.7-6.5 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </span>
        Mi centro · Coherencia dinámica
      </p>
      <p class="hero-sequence-preview" aria-hidden="true">
        Cambio <span>→</span> Perspectiva <span>→</span> Ciclo <span>→</span> Oposición <span>→</span> Integración <span>→</span> Equilibrio <strong>↻ Nuevo cambio</strong>
      </p>
      <h1 id="hero-title">Encuentra un centro desde el que poder cambiar con la vida.</h1>
      <p class="hero-lede">
        Virtus relaciona tu misión con lo que has vivido y decidido para ayudarte a comprender el cambio, reconocer tensiones y elegir tu siguiente movimiento.
      </p>
      <div class="hero-actions">
        <a
          class="button button--primary"
          href="#prueba-tu-mision"
          data-focus-demo
          data-track="mission_cta_clicked"
          data-track-location="hero"
        >
          Escribe tu misión
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          class="button button--ghost hero-center-action"
          href={mentorUrl}
          data-app-link
          data-track="center_cta_clicked"
          data-track-location="hero"
        >
          Ir a Mi centro
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-note">
        Tu misión es el centro declarado desde el que empieza la lectura.
      </p>
    </div>

    <div class="hero-formula-wrap">
      <CenterFormula />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    padding: 8.5rem 0 4.5rem;
    background:
      linear-gradient(155deg, rgb(255 253 249 / 76%), rgb(243 249 246 / 72%)),
      var(--background);
    color: var(--text);
  }

  .hero-ambient {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-blob {
    position: absolute;
    border-radius: var(--radius-blob);
    filter: blur(1px);
    will-change: transform;
  }

  .hero-blob--flow {
    top: -12rem;
    right: -15rem;
    width: clamp(31rem, 58vw, 56rem);
    height: clamp(30rem, 54vw, 52rem);
    background: radial-gradient(circle at 40% 48%, rgb(47 128 237 / 24%), rgb(47 128 237 / 8%) 48%, transparent 72%);
    animation: flow-drift 20s ease-in-out infinite alternate;
  }

  .hero-blob--root {
    bottom: -19rem;
    left: -18rem;
    width: clamp(34rem, 62vw, 59rem);
    height: clamp(31rem, 56vw, 54rem);
    border-radius: 58% 42% 34% 66% / 48% 62% 38% 52%;
    background: radial-gradient(circle at 56% 38%, rgb(47 107 79 / 20%), rgb(138 166 106 / 11%) 48%, transparent 72%);
    animation: root-drift 22s ease-in-out infinite alternate;
  }

  .hero-current {
    position: absolute;
    right: -4rem;
    bottom: -4rem;
    width: min(78rem, 105vw);
    height: 48rem;
    opacity: 0.18;
  }

  .hero-current path {
    fill: none;
    stroke: var(--root);
    stroke-linecap: round;
    stroke-width: 1.2;
  }

  .hero-current path:last-child {
    stroke: var(--flow);
    stroke-width: 0.9;
  }

  .hero-grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-copy {
    max-width: 45rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    margin-bottom: 1.45rem;
    color: var(--root);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.5;
  }

  .eyebrow-mark {
    display: inline-grid;
    width: 2rem;
    height: 1.3rem;
    flex: 0 0 auto;
    place-items: center;
    color: var(--flow);
  }

  .eyebrow-mark svg {
    width: 100%;
  }

  .hero-sequence-preview {
    margin: -0.55rem 0 1.15rem;
    color: var(--text-muted);
    font-size: 0.62rem;
    font-weight: 620;
    line-height: 1.65;
  }

  .hero-sequence-preview span {
    padding-inline: 0.1rem;
    color: var(--root);
  }

  .hero-sequence-preview strong {
    color: var(--root-deep);
    font-weight: 760;
  }

  h1 {
    max-width: 13ch;
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 2.05rem + 3.4vw, 5.15rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.01;
  }

  .hero-lede {
    max-width: 39rem;
    margin-bottom: 2rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-center-action {
    border-color: color-mix(in srgb, var(--root) 32%, var(--line));
    color: var(--root-deep);
  }

  .hero-note {
    max-width: 33rem;
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 550;
    line-height: 1.5;
  }

  .hero-formula-wrap {
    position: relative;
    min-width: 0;
  }

  .hero-formula-wrap::before {
    position: absolute;
    z-index: -1;
    inset: 7% -4% -5% 8%;
    border-radius: 35% 65% 58% 42% / 52% 38% 62% 48%;
    background: linear-gradient(145deg, rgb(47 128 237 / 15%), rgb(47 107 79 / 17%));
    content: '';
    filter: blur(18px);
  }

  @keyframes flow-drift {
    0% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }

    50% {
      transform: translate3d(-1.4rem, 1rem, 0) scale(1.035) rotate(2deg);
    }

    100% {
      transform: translate3d(1rem, 2rem, 0) scale(0.985) rotate(-2deg);
    }
  }

  @keyframes root-drift {
    0% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }

    50% {
      transform: translate3d(1.5rem, -1.2rem, 0) scale(1.025) rotate(-2deg);
    }

    100% {
      transform: translate3d(-0.8rem, -2rem, 0) scale(0.98) rotate(2.5deg);
    }
  }

  @media (min-width: 42rem) {
    .hero-actions {
      align-items: center;
      flex-direction: row;
    }
  }

  @media (min-width: 64rem) {
    .hero-sequence-preview {
      display: none;
    }

    .hero {
      display: flex;
      min-height: 54rem;
      align-items: center;
      padding: 8rem 0 4rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(34rem, 1.2fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-blob {
      animation: none;
      transform: none;
    }
  }
</style>
