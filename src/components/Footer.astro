---
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="brand-lockup" aria-label="NeruxAI Virtus — Inicio">
        <span class="footer-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <path d="M9 31c10-1 16-8 18-21 10 6 14 14 10 23-5 9-17 10-28-2Z" fill="currentColor" opacity=".2"></path>
            <path d="M11 35c7-9 15-15 25-18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            <path d="M15 29c5 0 9 2 11 6M22 23c4 0 7 2 9 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".65"></path>
          </svg>
        </span>
        <span><strong>NeruxAI</strong><small>Virtus, un producto de NeruxAI</small></span>
      </a>
      <p>Tecnología para cuidar tu salud física, mental y espiritual con dirección y contexto.</p>
    </div>

    <div class="footer-action">
      <span>¿Ya sabes qué quieres mover?</span>
      <a href="#prueba-tu-mision" data-focus-demo data-track="mission_cta_clicked" data-track-location="footer">Escribe tu misión <span aria-hidden="true">→</span></a>
    </div>

    <nav class="footer-nav" aria-label="Enlaces de pie de página">
      <div>
        <span>Virtus</span>
        <a href={appUrl} data-track="app_login_clicked" data-track-location="footer">Iniciar sesión</a>
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#perfiles">Perfiles</a>
      </div>
      <div>
        <span>NeruxAI</span>
        <a href="#neruxai">Sobre NeruxAI</a>
        <a href="mailto:hola@neruxai.com">Contacto</a>
        <a href="mailto:privacidad@neruxai.com?subject=Consulta%20de%20privacidad">Contacto de privacidad</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© {year} NeruxAI</span>
    <span>Hecho con intención en España</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4rem 0 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--root) 18%, var(--line));
    background:
      radial-gradient(ellipse at 10% 100%, color-mix(in srgb, var(--sage) 18%, transparent), transparent 25rem),
      color-mix(in srgb, var(--sage) 9%, var(--surface-strong));
    color: var(--text);
  }

  .footer-main {
    display: grid;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .footer-mark {
    width: 2.7rem;
    color: var(--root);
  }

  .brand-lockup strong,
  .brand-lockup small {
    display: block;
  }

  .brand-lockup strong {
    margin-bottom: 0.2rem;
    font-size: 1.05rem;
  }

  .brand-lockup small {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.62rem;
  }

  .footer-brand > p {
    max-width: 24rem;
    margin: 1.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .footer-action {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.55rem;
    border-left: 2px solid var(--root);
    padding-left: 1.1rem;
  }

  .footer-action > span {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .footer-action a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--root);
    font-weight: 500;
    font-style: italic;
    text-underline-offset: 0.25rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-nav > div {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-nav span {
    margin-bottom: 0.25rem;
    color: var(--root);
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 750;
  }

  .footer-nav a {
    color: var(--text-muted);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--root);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.58rem;
  }

  @media (min-width: 50rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.7fr) minmax(15rem, 0.8fr);
    }
  }
</style>
