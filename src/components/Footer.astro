---
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="brand-lockup" aria-label="NeruxAI Virtus — Inicio">
        <span class="footer-compass" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="1.3"></circle>
            <path d="m29 13-3 14-8 8 3-14 8-8Z" fill="currentColor"></path>
            <circle cx="24" cy="24" r="2.4" fill="#17181c"></circle>
          </svg>
        </span>
        <span><strong>NeruxAI</strong><small>Virtus, un producto de NeruxAI</small></span>
      </a>
      <p>Tecnología para cuidar tu salud física, mental y espiritual con dirección y contexto.</p>
    </div>

    <div class="footer-action">
      <span>¿Ya sabes qué quieres mover?</span>
      <a href="#prueba-tu-mision" data-focus-demo data-track="mission_cta_clicked" data-track-location="footer">Escribe tu misión <span aria-hidden="true">→</span></a>
    </div>

    <nav class="footer-nav" aria-label="Enlaces de pie de página">
      <div>
        <span>Virtus</span>
        <a href={appUrl} data-track="app_login_clicked" data-track-location="footer">Iniciar sesión</a>
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#perfiles">Perfiles</a>
      </div>
      <div>
        <span>NeruxAI</span>
        <a href="#neruxai">Sobre NeruxAI</a>
        <a href="mailto:hola@neruxai.com">Contacto</a>
        <a href="mailto:privacidad@neruxai.com?subject=Consulta%20de%20privacidad">Contacto de privacidad</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© {year} NeruxAI</span>
    <span>Hecho con intención en España</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4rem 0 1.5rem;
    background: var(--ink);
    color: var(--bone);
  }

  .footer-main {
    display: grid;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .footer-compass {
    width: 2.7rem;
    color: var(--ochre);
  }

  .brand-lockup strong,
  .brand-lockup small {
    display: block;
  }

  .brand-lockup strong {
    margin-bottom: 0.2rem;
    font-size: 1.05rem;
  }

  .brand-lockup small {
    color: rgb(242 238 230 / 52%);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
  }

  .footer-brand > p {
    max-width: 24rem;
    margin: 1.3rem 0 0;
    color: rgb(242 238 230 / 62%);
    font-size: 0.75rem;
  }

  .footer-action {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.55rem;
    border-left: 1px solid var(--ochre);
    padding-left: 1.1rem;
  }

  .footer-action > span {
    color: rgb(242 238 230 / 62%);
    font-size: 0.7rem;
  }

  .footer-action a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 570;
    text-underline-offset: 0.25rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-nav > div {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-nav span {
    margin-bottom: 0.25rem;
    color: rgb(242 238 230 / 62%);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-nav a {
    color: rgb(242 238 230 / 68%);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--bone);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line-on-dark);
    padding-top: 1.3rem;
    color: rgb(242 238 230 / 58%);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    letter-spacing: 0.04em;
  }

  @media (min-width: 50rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.7fr) minmax(15rem, 0.8fr);
    }
  }
</style>
