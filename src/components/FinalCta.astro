---
interface Props {
  subscriptionUrl: string;
}

const { subscriptionUrl } = Astro.props;
---

<section class="section final-cta" id="empieza" aria-labelledby="final-title" data-track-section="final_cta">
  <div class="container final-inner">
    <span class="section-kicker">El siguiente paso</span>
    <h2 id="final-title">Tu próxima misión te está esperando</h2>
    <p>No necesitas tener toda la vida resuelta. Solo una frase honesta y diez segundos para ver el primer camino.</p>
    <a class="button button--light" href="#prueba-tu-mision" data-focus-demo data-track="mission_cta_clicked" data-track-location="final_cta">
      Escribe tu misión
      <span aria-hidden="true">→</span>
    </a>
    <span class="final-note">Sin tarjeta · Prueba el resultado primero</span>

    <div class="premium-note">
      <div>
        <span>Para ir más allá</span>
        <strong>Una mirada más profunda, cuando la necesites.</strong>
        <p>Premium añade deep reasoning para explorar decisiones y patrones con más detalle.</p>
      </div>
      <a href={subscriptionUrl} data-track="premium_clicked" data-track-location="final_cta">
        Descubrir premium
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    overflow: hidden;
    min-height: 44rem;
    background:
      radial-gradient(ellipse at 8% 20%, color-mix(in srgb, var(--flow) 16%, transparent), transparent 28rem),
      radial-gradient(ellipse at 92% 78%, color-mix(in srgb, var(--sage) 24%, transparent), transparent 30rem),
      var(--surface-strong);
    color: var(--text);
  }

  .final-cta::before {
    position: absolute;
    top: 4rem;
    left: -8rem;
    width: 24rem;
    height: 17rem;
    border-radius: 69% 31% 55% 45% / 42% 64% 36% 58%;
    background: color-mix(in srgb, var(--flow) 10%, transparent);
    content: '';
    transform: rotate(12deg);
  }

  .final-cta::after {
    position: absolute;
    right: -9rem;
    bottom: 5rem;
    width: 26rem;
    height: 18rem;
    border-radius: 37% 63% 42% 58% / 61% 36% 64% 39%;
    background: color-mix(in srgb, var(--root) 10%, transparent);
    content: '';
    transform: rotate(-9deg);
  }

  .final-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .final-cta h2 {
    max-width: 13ch;
    margin-bottom: 1.2rem;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    font-style: italic;
    line-height: 1.02;
  }

  .final-inner > p {
    max-width: 39rem;
    margin-bottom: 2rem;
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .final-note {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 650;
  }

  .final-inner > .button {
    border-color: transparent;
    background: var(--gradient-action);
    box-shadow: var(--shadow-sm);
    color: var(--surface);
  }

  .final-inner > .button:hover {
    box-shadow: var(--shadow-lg);
  }

  .premium-note {
    display: grid;
    gap: 1.2rem 2rem;
    width: min(100%, 47rem);
    align-items: center;
    margin-top: 4.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.4rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    box-shadow: var(--shadow-sm);
    text-align: left;
  }

  .premium-note div > span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--root);
    font-family: var(--font-body);
    font-size: 0.64rem;
    font-weight: 750;
  }

  .premium-note strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    font-style: italic;
  }

  .premium-note p {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .premium-note > a {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.5rem;
    color: var(--flow-deep);
    font-size: 0.74rem;
    font-weight: 700;
    text-underline-offset: 0.25rem;
  }

  @media (min-width: 42rem) {
    .premium-note {
      grid-template-columns: 1fr auto;
    }

    .premium-note > a {
      justify-self: end;
    }
  }
</style>
