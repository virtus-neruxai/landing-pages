---
interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;

const profiles = [
  { name: 'Estoico', symbol: '⚖', description: 'Disciplina · claridad · virtud', tone: 'stoic' },
  { name: 'Espiritual', symbol: '◌', description: 'Raíz · valores · propósito', tone: 'spiritual' },
  { name: 'Calma', symbol: '≈', description: 'Respira · observa · avanza', tone: 'calm' },
  { name: 'Rendimiento', symbol: '↗', description: 'Energía · ritmo · acción', tone: 'performance' },
  { name: 'Estudiante', symbol: '⌁', description: 'Lectura · método · futuro', tone: 'student' },
];

const futureZones = [
  { label: 'Para Estoico', route: '/estoico', tone: 'stoic' },
  { label: 'Para Espiritual', route: '/espiritual', tone: 'spiritual' },
  { label: 'Para Calma', route: '/calma', tone: 'calm' },
  { label: 'Para Estudiante', route: '/estudiante', tone: 'student' },
  { label: 'Para Rendimiento', route: '/rendimiento', tone: 'performance' },
];
---

<section class="section profiles" id="perfiles" aria-labelledby="profiles-title" data-track-section="profiles">
  <div class="container">
    <div class="profiles-heading">
      <div>
        <span class="section-kicker">Un mentor con tu tono</span>
        <h2 class="section-title" id="profiles-title">Tu mentor no habla igual con todo el mundo</h2>
      </div>
      <div>
        <p class="section-lede">Elige la perspectiva que te ayuda a escuchar y actuar. La dirección es la misma; cambia la forma de acompañarte.</p>
        <a class="profile-discover" href={`${appUrl}/profile`} data-app-link data-track="profile_cta_clicked" data-track-location="profiles">
          Descubre tu perfil
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="profile-list">
      {profiles.map((profile, index) => (
        <article class:list={['profile-card', `profile-card--${profile.tone}`]}>
          <div class="profile-top">
            <span class="profile-index">0{index + 1}</span>
            <span class="profile-symbol" aria-hidden="true">{profile.symbol}</span>
          </div>
          <h3>{profile.name}</h3>
          <p>{profile.description}</p>
        </article>
      ))}
    </div>

    <section class="future-zones" aria-labelledby="future-zones-title">
      <div>
        <span class="future-label">Recorridos específicos</span>
        <h3 id="future-zones-title">Encuentra el recorrido para tu momento</h3>
        <p>Explora una experiencia centrada en la voz, el ritmo y la perspectiva que mejor acompañan tu momento.</p>
      </div>
      <div class="zone-buttons">
        {futureZones.map((zone) => (
          <a class={`zone-link--${zone.tone}`} href={zone.route} data-route={zone.route} data-track="profile_zone_clicked" data-track-location="profiles" data-track-profile={zone.tone} data-track-label={zone.label}>
            {zone.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</section>

<style>
  .profiles {
    overflow: hidden;
    background: var(--surface);
  }

  .profiles-heading {
    display: grid;
    gap: 1.5rem 5rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .profiles-heading .section-title,
  .profiles-heading .section-lede {
    margin-bottom: 0;
  }

  .profile-discover {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1rem;
    color: var(--root);
    font-size: 0.9rem;
    font-weight: 700;
    text-underline-offset: 0.25rem;
  }

  .profile-list {
    display: grid;
    gap: 0.75rem;
  }

  .profile-card {
    --profile-color: var(--flow);
    --profile-secondary: var(--flow-deep);
    --profile-heading: var(--profile-secondary);
    --profile-font: var(--font-body);
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.3rem;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--profile-color) 9%, var(--surface)) 0%, var(--surface) 58%);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .profile-card::after {
    position: absolute;
    right: -3.2rem;
    bottom: -3.5rem;
    width: 8.2rem;
    height: 7.5rem;
    border-radius: 62% 38% 53% 47% / 39% 61% 39% 61%;
    background: color-mix(in srgb, var(--profile-secondary) 9%, transparent);
    content: '';
    transform: rotate(-14deg);
  }

  .profile-card:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-3px);
  }

  .profile-card--stoic {
    --profile-color: #c6a75e;
    --profile-secondary: #8b2f1f;
    --profile-font: var(--font-stoic);
  }

  .profile-card--calm {
    --profile-color: #2f80ed;
    --profile-secondary: #174a7c;
    --profile-font: var(--font-calm);
  }

  .profile-card--spiritual {
    --profile-color: #2f6b4f;
    --profile-secondary: #8aa66a;
    --profile-heading: var(--profile-color);
    --profile-font: var(--font-spiritual);
  }

  .profile-card--performance {
    --profile-color: #e0702f;
    --profile-secondary: #9c3f1b;
    --profile-font: var(--font-performance);
  }

  .profile-card--student {
    --profile-color: #d8b56d;
    --profile-secondary: #5d78a6;
    --profile-font: var(--font-student);
  }

  .profile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.3rem;
    color: color-mix(in srgb, var(--profile-heading) 82%, var(--text));
  }

  .profile-index {
    font-family: var(--font-body);
    font-size: 0.67rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .profile-symbol {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--profile-color) 36%, transparent);
    border-radius: 64% 36% 56% 44% / 40% 64% 36% 60%;
    background: color-mix(in srgb, var(--profile-color) 10%, var(--surface));
    color: var(--profile-color);
    font-family: var(--profile-font);
    font-size: 1.15rem;
  }

  .profile-card h3 {
    margin-bottom: 0.3rem;
    position: relative;
    z-index: 1;
    color: var(--profile-heading);
    font-family: var(--profile-font);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .profile-card p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.7rem;
  }

  .future-zones {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: center;
    margin-top: 2rem;
    border: 1px solid color-mix(in srgb, var(--flow) 22%, var(--line));
    border-radius: var(--radius-md);
    padding: clamp(1.2rem, 4vw, 2rem);
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--flow) 8%, var(--surface)), color-mix(in srgb, var(--root) 8%, var(--surface)));
  }

  .future-label {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--root);
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 750;
  }

  .future-zones h3 {
    margin-bottom: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    font-style: italic;
  }

  .future-zones p {
    max-width: 38rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .zone-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .zone-buttons a {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--flow) 22%, var(--line));
    border-radius: 999px;
    padding: 0.7rem 1rem;
    background: color-mix(in srgb, var(--surface) 74%, transparent);
    color: var(--flow-deep);
    cursor: pointer;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .zone-buttons a:hover {
    border-color: color-mix(in srgb, var(--flow) 50%, var(--line));
    background: var(--surface);
    transform: translateY(-1px);
  }

  .zone-buttons .zone-link--student {
    border-color: color-mix(in srgb, #5d78a6 34%, var(--line));
    background: color-mix(in srgb, #d8b56d 10%, var(--surface));
    color: #4d668f;
  }

  .zone-buttons .zone-link--performance {
    border-color: color-mix(in srgb, #9c3f1b 30%, var(--line));
    background: color-mix(in srgb, #e0702f 9%, var(--surface));
    color: #8b3519;
  }

  .zone-buttons .zone-link--stoic {
    border-color: color-mix(in srgb, #8b2f1f 32%, var(--line));
    background: color-mix(in srgb, #c6a75e 10%, var(--surface));
    color: #78291c;
  }

  .zone-buttons .zone-link--spiritual {
    border-color: color-mix(in srgb, #2f6b4f 34%, var(--line));
    background: color-mix(in srgb, #8aa66a 11%, var(--surface));
    color: #24573f;
  }

  .zone-buttons .zone-link--calm {
    border-color: color-mix(in srgb, #174a7c 32%, var(--line));
    background: color-mix(in srgb, #2f80ed 9%, var(--surface));
    color: #174a7c;
  }

  @media (min-width: 34rem) {
    .profile-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 54rem) {
    .profiles-heading {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.75fr);
    }

    .profile-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .future-zones {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .zone-buttons {
      justify-content: flex-end;
    }
  }
</style>
