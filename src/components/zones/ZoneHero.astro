---
import SituationSelector from './SituationSelector';
import type { ZoneProfile } from './zoneContent';

interface Props {
  profile: ZoneProfile;
  eyebrow: string;
  title: string;
  lede: string;
  selectorLabel: string;
  ctaLabel: string;
  microcopy: string;
}

const { profile, eyebrow, title, lede, selectorLabel, ctaLabel, microcopy } = Astro.props;
---

<section class:list={['zone-hero', `zone-hero--${profile}`]} id="zone-hero" aria-labelledby={`${profile}-hero-title`} data-track-section={`${profile}_hero`}>
  <div class="zone-hero__ambient" aria-hidden="true">
    <span class="zone-hero__blob zone-hero__blob--primary"></span>
    <span class="zone-hero__blob zone-hero__blob--secondary"></span>
    <svg class="zone-hero__path" viewBox="0 0 900 540" preserveAspectRatio="none">
      {profile === 'student' ? (
        <>
          <path d="M-40 475C128 355 205 443 330 338S547 201 922 260"></path>
          <path d="M330 338c72-22 120-80 148-166"></path>
          <path d="M330 338c95 9 168 57 214 142"></path>
        </>
      ) : (
        <>
          <path d="M-35 446C170 383 308 391 454 310S690 163 930 145"></path>
          <path d="M-35 490C176 426 318 431 468 350S704 202 930 185"></path>
          <path d="M-35 402C164 344 298 351 442 270S680 123 930 105"></path>
        </>
      )}
    </svg>
  </div>

  <div class="container zone-hero__grid">
    <div class="zone-hero__copy">
      <p class="zone-hero__eyebrow">{eyebrow}</p>
      <h1 class="zone-title" id={`${profile}-hero-title`}>{title}</h1>
      <p class="zone-hero__lede">{lede}</p>
    </div>

    <div class="zone-hero__selector">
      <SituationSelector
        client:load
        profile={profile}
        label={selectorLabel}
        ctaLabel={ctaLabel}
        microcopy={microcopy}
      />
    </div>
  </div>
</section>

<style>
  .zone-hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    padding: 10rem 0 5rem;
    background:
      linear-gradient(150deg, rgb(255 253 249 / 84%), color-mix(in srgb, var(--zone-soft) 72%, transparent)),
      var(--background);
  }

  .zone-hero__ambient {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .zone-hero__blob {
    position: absolute;
    border-radius: var(--radius-blob);
    will-change: transform;
  }

  .zone-hero__blob--primary {
    top: -12rem;
    right: -13rem;
    width: clamp(30rem, 58vw, 55rem);
    height: clamp(28rem, 52vw, 50rem);
    background: radial-gradient(circle at 42% 54%, color-mix(in srgb, var(--zone-primary) 28%, transparent), transparent 68%);
    animation: zone-primary-drift 21s ease-in-out infinite alternate;
  }

  .zone-hero__blob--secondary {
    bottom: -19rem;
    left: -17rem;
    width: clamp(34rem, 62vw, 58rem);
    height: clamp(30rem, 55vw, 53rem);
    border-radius: 60% 40% 35% 65% / 46% 62% 38% 54%;
    background: radial-gradient(circle at 58% 38%, color-mix(in srgb, var(--zone-secondary) 20%, transparent), transparent 70%);
    animation: zone-secondary-drift 23s ease-in-out infinite alternate;
  }

  .zone-hero__path {
    position: absolute;
    right: -5rem;
    bottom: -2rem;
    width: min(65rem, 112vw);
    height: 40rem;
    opacity: 0.22;
  }

  .zone-hero__path path {
    fill: none;
    stroke: var(--zone-secondary);
    stroke-linecap: round;
    stroke-width: 1.2;
  }

  .zone-hero__path path:not(:first-child) {
    stroke: var(--zone-primary);
    stroke-width: 0.9;
  }

  .zone-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .zone-hero__copy {
    max-width: 44rem;
  }

  .zone-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    color: var(--zone-action);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .zone-hero__eyebrow::before {
    width: 1.55rem;
    height: 0.7rem;
    border: 2px solid currentColor;
    border-top: 0;
    border-right: 0;
    border-radius: 0 0 0 100%;
    content: '';
    transform: rotate(-18deg);
  }

  h1 {
    max-width: 13ch;
    margin-bottom: 1.45rem;
    color: var(--text);
    font-size: clamp(2.75rem, 7.4vw, 5.5rem);
    line-height: 1.01;
  }

  .zone-hero--performance h1 {
    max-width: 14ch;
    font-size: clamp(2.55rem, 6.5vw, 5.05rem);
    line-height: 1.03;
  }

  .zone-hero__lede {
    max-width: 38rem;
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .zone-hero__selector {
    min-width: 0;
  }

  @keyframes zone-primary-drift {
    from { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
    50% { transform: translate3d(-1.2rem, 1rem, 0) scale(1.035) rotate(2deg); }
    to { transform: translate3d(0.8rem, 1.8rem, 0) scale(0.985) rotate(-2deg); }
  }

  @keyframes zone-secondary-drift {
    from { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
    50% { transform: translate3d(1.3rem, -1rem, 0) scale(1.025) rotate(-2deg); }
    to { transform: translate3d(-0.8rem, -1.7rem, 0) scale(0.98) rotate(2deg); }
  }

  @media (min-width: 64rem) {
    .zone-hero {
      display: flex;
      min-height: 50rem;
      align-items: center;
      padding: 8.2rem 0 4.5rem;
    }

    .zone-hero__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(28rem, 0.82fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zone-hero__blob {
      animation: none;
      transform: none;
    }
  }
</style>
