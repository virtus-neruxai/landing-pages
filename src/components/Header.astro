---
interface Props {
  appUrl: string;
  variant?: 'global' | 'zone';
}

const { appUrl, variant = 'global' } = Astro.props;
---

<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="NeruxAI Virtus — Inicio">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none">
          <path d="M9.5 23.6c5.1-9.2 13.5-12.4 21.8-11.8-.5 8.7-5.8 16.2-16.3 17.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
          <path d="M10.1 29.4c6.4-6.4 12.9-10.3 20.7-14.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"></path>
          <path d="M8.7 31.1c4.9 2.2 9.8 2.1 14.4.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="brand-name">NeruxAI</span>
      <span class="brand-product">Virtus</span>
    </a>

    <nav class="header-nav" aria-label="Navegación principal">
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#diferencia">La diferencia</a>
      <a href="#perfiles">Perfiles</a>
    </nav>

    <a
      class="login-link"
      href={appUrl}
      data-track="app_login_clicked"
      data-track-location="header"
    >
      <span class="login-long">Iniciar sesión</span>
      <span class="login-short">Entrar</span>
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
        <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    height: 4.7rem;
    border-bottom: 1px solid rgb(47 107 79 / 14%);
    background: rgb(248 245 242 / 82%);
    color: var(--text);
    box-shadow: 0 8px 28px rgb(47 107 79 / 5%);
    backdrop-filter: blur(20px) saturate(145%);
  }

  .header-inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 44% 56% 58% 42% / 48% 42% 58% 52%;
    background: var(--gradient-brand);
    color: var(--white);
    box-shadow: 0 7px 18px rgb(41 103 121 / 19%);
  }

  .brand-mark svg {
    width: 1.72rem;
    height: 1.72rem;
  }

  .brand-name {
    font-size: 1.03rem;
    font-weight: 740;
    letter-spacing: 0;
  }

  .brand-product {
    border: 1px solid rgb(47 107 79 / 22%);
    border-radius: 999px;
    padding: 0.18rem 0.55rem;
    background: rgb(255 253 249 / 72%);
    color: var(--root);
    font-family: var(--font-body);
    font-size: 0.69rem;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.35;
    text-transform: none;
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 1.7rem;
  }

  .header-nav a {
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 550;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .header-nav a:hover {
      color: var(--root);
  }

  .login-link {
    display: inline-flex;
    min-height: 2.55rem;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.6rem 0.85rem;
    background: var(--gradient-action);
    color: var(--white);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 8px 20px rgb(40 101 128 / 17%);
    transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
  }

  .login-link:hover {
    filter: saturate(108%) brightness(0.96);
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgb(40 101 128 / 24%);
  }

  .login-link svg {
    width: 1rem;
    height: 1rem;
  }

  .login-long {
    display: none;
  }

  @media (min-width: 44rem) {
    .login-long {
      display: inline;
    }

    .login-short {
      display: none;
    }
  }

  @media (min-width: 60rem) {
    .header-nav {
      display: flex;
    }

    .login-link {
      padding-inline: 1rem;
    }
  }
</style>
